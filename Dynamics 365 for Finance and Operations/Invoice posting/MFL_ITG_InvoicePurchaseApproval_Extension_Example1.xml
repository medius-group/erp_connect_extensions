﻿/// <summary>
/// map mFL_ITG_InvoicePOConnectionLine custom fields to custom fields on VendInvoiceInfoLine, Medius APA has 5 custom fields of each type.
/// </summary>
[ExtensionOf(ClassStr(MFL_ITG_InvoicePurchaseApproval))]
final class MFL_ITG_InvoicePurchaseApproval_Extension
{
    protected void updateLine()
    {
        next updateLine();

        VendInvoiceInfoLine localVendInvoiceInfoLine = this.refLine;

        localVendInvoiceInfoLine.selectForUpdate(true);
        localVendInvoiceInfoLine.MyNumericCustomField     = mFL_ITG_InvoicePOConnectionLine.customFieldNumeric1;
        localVendInvoiceInfoLine.MyBooleanCustomField     = mFL_ITG_InvoicePOConnectionLine.customFieldBoolean1;
        localVendInvoiceInfoLine.MyStrCustomField         = mFL_ITG_InvoicePOConnectionLine.customFieldText1;
        localVendInvoiceInfoLine.MyCustomDateTimeField    = mFL_ITG_InvoicePOConnectionLine.customFieldDateTime1;
        localVendInvoiceInfoLine.update();
    }
}